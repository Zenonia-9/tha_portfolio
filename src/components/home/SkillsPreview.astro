---
import SectionTitle from "../ui/SectionTitle.astro";
const groups=[{title:"Area One",description:"Add a short description of this capability.",tone:"bg-primary-soft/70"},{title:"Area Two",description:"Describe a skill or type of work you choose to share.",tone:"bg-card"},{title:"Area Three",description:"Highlight another area of interest or experience.",tone:"bg-secondary-soft/70"}];
---
<section class="py-14 sm:py-20"><SectionTitle description="Use this space to highlight skills and capabilities relevant to your portfolio." eyebrow="Capabilities" title="What I do"/><div class="mt-10 grid gap-5 lg:grid-cols-3">{groups.map(group=><article class:list={["surface-card p-6",group.tone]}><p class="font-mono text-xs uppercase tracking-[0.24em] text-primary">Core area</p><h3 class="mt-4 font-display text-2xl font-bold text-text">{group.title}</h3><p class="mt-4 text-sm leading-7 text-muted">{group.description}</p></article>)}</div></section>
