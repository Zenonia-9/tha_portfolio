---
import { getCollection } from "astro:content";
import ProjectCard from "../projects/ProjectCard.jsx";
import SectionTitle from "../ui/SectionTitle.astro";

const featuredProjects = (await getCollection("projects", ({ data }) => data.published))
  .filter((project) => project.data.featured && project.data.status === "Completed")
  .sort((a, b) => b.data.year - a.data.year);
---

<section class="py-14 sm:py-20">
  <SectionTitle
    description="Replace these sample entries with projects you choose to share publicly."
    eyebrow="Featured Work"
    title="Selected Projects"
  />

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    {featuredProjects.map((project) => (
      <ProjectCard project={{ ...project.data, slug: project.slug }} />
    ))}
  </div>
</section>
